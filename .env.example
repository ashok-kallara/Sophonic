# Copy to ~/.sophonic/.env and fill in. This file is loaded automatically by
# Sophonic (no shell-profile exports needed). Tip: `sophonic init` or
# `sophonic config set-secret <NAME> --stdin` write it for you (chmod 0600).

# LLM API key — one variable works for ANY provider (anthropic/openai/litellm):
SOPHONIC_LLM_API_KEY=...

# Standard native vars are also honored as a fallback (optional):
# ANTHROPIC_API_KEY=sk-ant-...   # used when provider = "anthropic"
# OPENAI_API_KEY=sk-...          # used when provider = "openai"

# Optional per-run overrides:
# SOPHONIC_LLM_PROVIDER=litellm
# SOPHONIC_LLM_MODEL=gpt-4o

# Slack: read from the Slack desktop app automatically. Set this only if the
# xoxc token can't be auto-detected (else Sophonic caches it here for you):
# SLACK_XOXC_TOKEN=xoxc-...

# Zoom: paste your zoom.us web session cookies as a single header string:
# ZOOM_COOKIES=_zm_ssid=...; zm_aid=...; ...

# Optional: override vault path without editing config.toml
# SOPHONIC_VAULT=/path/to/your/obsidian/vault
