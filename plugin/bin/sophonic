#!/usr/bin/env bash
# Wrapper so Claude Code can run `sophonic` on PATH while this plugin is enabled.
#
# It runs the CLI from the Sophonic project checkout via uv. The project is the
# parent of this plugin directory (plugin/ lives inside the repo). Override with
# SOPHONIC_PROJECT_DIR if you keep the plugin elsewhere.
set -euo pipefail

if [ -n "${SOPHONIC_PROJECT_DIR:-}" ]; then
  PROJECT_DIR="$SOPHONIC_PROJECT_DIR"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  PROJECT_DIR="$(cd "$CLAUDE_PLUGIN_ROOT/.." && pwd)"
else
  PROJECT_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
fi

exec uv run --project "$PROJECT_DIR" sophonic "$@"
